from google.colab import files

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy.signal import butter, filtfilt, find_peaks


# Primero subimos los tres archivos correspondientes
# a las derivaciones I, II y III en condición de reposo.

uploaded = files.upload()

# Guardamos los nombres de los archivos que se subieron.
filenames = list(uploaded.keys())

print("Archivos cargados:")
for f in filenames:
    print("-", f)


# Identificamos automáticamente qué archivo corresponde
# a cada derivación a partir de su nombre.
#
# Por ejemplo:
# BASALD1.txt -> Derivación I
# BASALD2.txt -> Derivación II
# BASALD3.txt -> Derivación III

file_D1 = [f for f in filenames if 'D1' in f.upper()][0]
file_D2 = [f for f in filenames if 'D2' in f.upper()][0]
file_D3 = [f for f in filenames if 'D3' in f.upper()][0]

print("\nArchivos identificados:")
print("Derivación I :", file_D1)
print("Derivación II:", file_D2)
print("Derivación III:", file_D3)


# Parámetros del sistema BITalino utilizado para adquirir el ECG.
# La señal fue registrada a 1000 muestras por segundo.
# El canal A2 tiene una resolución de 10 bits.

fs = 1000
n_bits = 10
VCC = 3.3
G = 1100


# Esta función realiza todo el procesamiento de un archivo ECG:
# lectura del archivo, conversión a mV, filtrado,
# detección de picos R, selección de un segmento
# y generación de la gráfica.

def procesar_ecg(filename, titulo):

    # Leemos el archivo exportado desde OpenSignals.
    # Las líneas que empiezan con "#" corresponden al encabezado,
    # por eso se ignoran.

    data = pd.read_csv(
        filename,
        comment='#',
        sep='\t',
        header=None
    )

    # Eliminamos posibles columnas vacías al final del archivo.

    data = data.dropna(axis=1, how='all')


    # La señal ECG se encuentra en la sexta columna,
    # correspondiente al canal analógico A2.

    adc = data.iloc[:, 5].to_numpy(dtype=float)


    # Los datos originalmente están expresados como valores
    # digitales del ADC, por lo que primero los convertimos a voltaje.

    voltage = adc * VCC / (2**n_bits)


    # La señal medida está centrada aproximadamente en VCC/2.
    # Restamos ese nivel de referencia y luego dividimos entre
    # la ganancia del sensor para obtener la amplitud del ECG.
    #
    # Finalmente multiplicamos por 1000 para expresar el resultado en mV.

    ecg_mv = (
        (voltage - VCC / 2)
        / G
        * 1000
    )


    # Se elimina cualquier pequeño desplazamiento residual
    # de la línea de base utilizando la mediana de la señal.

    ecg_mv = ecg_mv - np.median(ecg_mv)


    # Creamos el vector de tiempo.
    # Como fs = 1000 Hz, cada muestra está separada 0.001 s.

    N = len(ecg_mv)
    t = np.arange(N) / fs


    # Aplicamos un filtro pasa banda para conservar
    # principalmente las frecuencias útiles del ECG.
    #
    # Se utiliza el rango de 0.5 a 40 Hz para reducir
    # la deriva de línea base y el ruido de alta frecuencia.

    nyquist = fs / 2

    low = 0.5 / nyquist
    high = 40 / nyquist

    b, a = butter(
        4,
        [low, high],
        btype='band'
    )

    ecg_filtered = filtfilt(
        b,
        a,
        ecg_mv
    )


    # Detectamos los posibles picos R de la señal.
    # Estos picos permiten identificar aproximadamente
    # la posición de cada latido cardíaco.

    min_distance = int(0.5 * fs)

    # La prominencia se calcula en función de la variabilidad
    # de la señal para evitar utilizar un umbral fijo.

    prominence = 0.5 * np.std(ecg_filtered)

    peaks, _ = find_peaks(
        ecg_filtered,
        distance=min_distance,
        prominence=prominence
    )


    # Para que la gráfica sea más fácil de analizar,
    # seleccionamos aproximadamente 5 ciclos cardíacos.
    #
    # Se toma una zona intermedia del registro para evitar
    # posibles artefactos al inicio o al final de la adquisición.

    num_cycles = 5

    if len(peaks) >= num_cycles + 1:

        center_peak = len(peaks) // 2

        start_peak_index = max(
            0,
            center_peak - num_cycles // 2
        )

        end_peak_index = min(
            len(peaks) - 1,
            start_peak_index + num_cycles
        )


        # Agregamos un pequeño margen antes y después
        # para visualizar mejor las ondas cercanas al QRS.

        start_sample = max(
            0,
            peaks[start_peak_index] - int(0.3 * fs)
        )

        end_sample = min(
            N,
            peaks[end_peak_index] + int(0.5 * fs)
        )

    else:

        # Si no se detectan suficientes picos R,
        # se muestran simplemente los primeros 5 segundos.

        start_sample = 0
        end_sample = min(N, int(5 * fs))


    # Recortamos el segmento seleccionado.

    t_segment = t[start_sample:end_sample]
    ecg_segment = ecg_filtered[start_sample:end_sample]


    # Hacemos que el segmento empiece en tiempo = 0 s
    # para facilitar la lectura de la gráfica.

    t_segment = t_segment - t_segment[0]


    # Graficamos finalmente la señal procesada.

    plt.figure(figsize=(14, 5))

    plt.plot(
        t_segment,
        ecg_segment,
        linewidth=1.2
    )

    plt.title(
        titulo,
        fontsize=15,
        fontweight='bold'
    )

    plt.xlabel(
        'Tiempo (s)',
        fontsize=12
    )

    plt.ylabel(
        'Amplitud (mV)',
        fontsize=12
    )


    # Se agrega una cuadrícula para facilitar
    # la lectura temporal y de amplitud.

    plt.grid(
        True,
        alpha=0.3
    )


    # Línea horizontal en 0 mV como referencia.

    plt.axhline(
        0,
        linewidth=0.8,
        alpha=0.5
    )

    plt.tight_layout()
    plt.show()


# Procesamos cada una de las tres derivaciones
# usando exactamente el mismo procedimiento.

procesar_ecg(
    file_D1,
    'ECG en reposo - Derivación I'
)

procesar_ecg(
    file_D2,
    'ECG en reposo - Derivación II'
)

procesar_ecg(
    file_D3,
    'ECG en reposo - Derivación III'
)